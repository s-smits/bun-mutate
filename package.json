{
  "name": "bun-mutate",
  "version": "0.1.0",
  "description": "Fast, zero-config mutation testing for Bun and TypeScript with in-process mutant schemata and process-isolated fallback",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bun-mutate": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
